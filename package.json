{
  "name": "start-nestjs",
  "version": "0.1.0",
  "description": "A project template serving as scaffolding for a NestJS project",
  "author": "marcos.lin@farport.co",
  "license": "MIT",
  "main": "dist/main",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "yarn@4.9.2",
  "scripts": {
    "build:alias": "tsc-alias --project ./tsconfig.build.json",
    "build:clean": "rm -f tsconfig*.tsbuildinfo || true && rm -rf dist && rm -rf build",
    "build:ts": "nest build --path ./tsconfig.build.json",
    "build:webpack": "nest build --webpack",
    "build": "yarn lint && yarn build:clean && yarn build:ts && yarn build:alias && yarn test:dist",
    "lint:format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "lint:ts": "eslint \"{src,test}/**/*.ts\" --fix",
    "lint": "yarn lint:ts && yarn lint:format",
    "test:e2e": "FP8_ENV=utest jest --config ./jest.config.e2e.ts",
    "test:unit": "FP8_ENV=utest jest --config ./jest.config.ts",
    "test:dist": "FP8_ENV=utest jest --config ./jest.config.lib.ts",
    "test:debug": "FP8_ENV=utest jest --config ./jest.config.ts --runInBand --bail",
    "test": "yarn test:unit",
    "start": "nest start"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.18.0",
    "@nestjs/cli": "^11.0.7",
    "@nestjs/schematics": "^11.0.5",
    "@nestjs/testing": "^11.1.5",
    "@types/express": "^5.0.3",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.0.15",
    "@types/supertest": "^6.0.3",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "jest": "^30.0.4",
    "prettier": "^3.4.2",
    "supertest": "^7.1.3",
    "terser-webpack-plugin": "^5.3.14",
    "ts-jest": "^29.4.0",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsc-alias": "^1.8.16",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0",
    "webpack": "^5.100.2"
  },
  "dependencies": {
    "@fp8/simple-config": "^0.7.0",
    "@nestjs/common": "^11.1.5",
    "@nestjs/core": "^11.1.5",
    "@nestjs/platform-express": "^11.1.5",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "jlog-facade": "^0.9.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  }
}
